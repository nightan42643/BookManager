{
  "manifest_version": 3,
  "name": "书签管理器",
  "version": "1.2.3",
  "description": "一个简洁高效的 Chrome 书签管理工具，帮助您更好地组织和访问书签",
  "permissions": [
    "bookmarks",
    "storage",
    "tabs",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
